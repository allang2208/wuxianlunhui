{
  "id": "steam_arsenal_industrial",
  "name": "蒸汽军工厂",
  "revision": 3,
  "revisionBrief": "按用户反馈，装卸门双扇向内打开90度；原实心墙切出真实凹入门洞，暗面与门内工具架后移。保留上一版材料箱、工具、加工机和其他主体。",
  "source": "tools/ai-gen/_settlement_building_pack_20260821/blacksmith_lv2/blacksmith_lv2_model.blend",
  "sourcePreview": "tools/ai-gen/_settlement_building_pack_20260821/blacksmith_lv2/blacksmith_lv2_model_approval_preview.png",
