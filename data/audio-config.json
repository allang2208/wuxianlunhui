    "ui": 1.0,
    "music": 0.6
  },
  "uiCues": {
    "comment": "全局系统提示音；使用 playFile + ui 声道，不做世界坐标衰减",
    "playerUpgrade": "assets/sounds/ui/player_upgrade.mp3",
    "rightSidebarPanel": "assets/sounds/ui/right_sidebar_panel.mp3",
    "buttonClick": "assets/sounds/ui/button_click.mp3",
    "worldMap": {
